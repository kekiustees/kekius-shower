{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["index.html", "logo.jpg", "package.json"]
      }
    }
  ],
  "routes": [
    { "src": "/logo.jpg", "dest": "server.js" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
